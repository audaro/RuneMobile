# Native style (C / C++ / Objective-C / Objective-C++) for our shell + bridge code.
# Tuned to match the existing hand-written style and to MINIMISE churn: ColumnLimit 0 means lines are
# never reflowed/wrapped (only indentation + intra-line spacing is normalised), and includes are not
# reordered (Obj-C import order can matter). Vendored JDK headers (RuneMobile/jni/*) are excluded by the
# runner, not by this file. Two language blocks: clang-format needs an explicit ObjC section for .m/.mm.
---
Language:        Cpp
BasedOnStyle:    LLVM
IndentWidth:     4
TabWidth:        4
UseTab:          Never
ColumnLimit:     0
BreakBeforeBraces: Attach
PointerAlignment: Right
AlignTrailingComments: true
SortIncludes:    false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
IndentCaseLabels: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
SpaceBeforeParens: ControlStatements
---
Language:        ObjC
BasedOnStyle:    LLVM
IndentWidth:     4
TabWidth:        4
UseTab:          Never
ColumnLimit:     0
BreakBeforeBraces: Attach
PointerAlignment: Right
AlignTrailingComments: true
SortIncludes:    false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
IndentCaseLabels: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
SpaceBeforeParens: ControlStatements
ObjCBlockIndentWidth: 4
ObjCSpaceAfterProperty: true
ObjCSpaceBeforeProtocolList: true
...
