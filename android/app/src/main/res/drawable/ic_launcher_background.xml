<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher-icon background: the OSRS-toned brown gradient (same palette as the TV banner).
     The adaptive-icon system bleeds this to the full 108dp canvas behind the foreground glyph. -->
