# PROD-RELEASE-ENG-02 — release signing config (template; copy to android/keystore.properties).
#
# android/keystore.properties is GITIGNORED — the real key material never enters the repo. When this file is
# present, `:app:assembleRelease` signs with this key; when absent, it falls back to the AOSP debug key so a
# fresh clone / CI still builds an installable APK (app/build.gradle.kts).
#
# Generate a key (one-time; keep the .jks OUT of the repo — store it + these passwords in a password manager):
#
#   keytool -genkeypair -v -keystore release.jks -alias runemobile \
#     -keyalg RSA -keysize 4096 -validity 10000 -storetype JKS
#
# Then copy this file to android/keystore.properties and fill in the values below.
#
# storeFile is resolved relative to the android/ directory (rootProject). Prefer a path OUTSIDE the repo tree,
# e.g. an absolute path, so the .jks can never be committed by accident.
#
# ROTATION WARNING: Android verifies update-in-place by signature. Once a signed APK has been shared, switching
# to a different key breaks updates for anyone on the old signature (they must uninstall + reinstall). Keep the
# same keystore for the life of the distribution; if it is lost, a new signature = a clean-install migration.

storeFile=/absolute/path/to/release.jks
storePassword=CHANGE_ME
keyAlias=runemobile
keyPassword=CHANGE_ME
