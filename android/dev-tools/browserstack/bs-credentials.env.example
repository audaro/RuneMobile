# Copy to bs-credentials.env (gitignored), fill in, then `source bs-credentials.env`.
# Get these from your BrowserStack App Automate account: Dashboard -> Account/Profile -> "Username" + "Access Key".
# NOTE: you need an *App Automate* plan (programmatic). App Live is interactive-only and can't be driven by this.

export BROWSERSTACK_USERNAME="your_username"
export BROWSERSTACK_ACCESS_KEY="your_access_key"

# Default real device for the gates — pick a modern arm64 (GLES 3.1+ matters for the GPU track / AG0):
export BS_DEVICE="Google Pixel 8"
export BS_OS_VERSION="14.0"

# Seconds to let the app run before pulling logcat (boot -> LOGGED_IN -> census). Bump if the device is slow.
export BS_WAIT="150"
